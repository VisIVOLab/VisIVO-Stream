APP_NAME=VisIVO-Stream API
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATASETS_DIR=./data/samples
REMOTE_DATA_ROOT=./data
REMOTE_BROWSER_SHOW_HIDDEN=false
RUNTIME_UPLOAD_DIR=./runtime/uploads
MAX_UPLOAD_SIZE_MB=256
RENDERS_DIR=./renders
PARAVIEW_SCRIPT=./scripts/render_dataset.py
PVPYTHON_BIN=pvpython
PVSERVER_BIN=pvserver
MPIEXEC_BIN=mpiexec
SRUN_BIN=srun
PVSERVER_LAUNCH_MODE=local
PVSERVER_CONNECT_HOST=127.0.0.1
PVSERVER_CONNECT_PORT=
PVSERVER_NODES=1
PVSERVER_RANKS_PER_NODE=1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRAME_HOST=127.0.0.1
TRAME_PORT=8081
TRAME_DATASET_ID=
API_BASE_URL=http://127.0.0.1:8000/api/v1
INTERACTIVE_LOGS_DIR=./runtime/interactive
PROJECT_ROOT=.
TRAME_SITE_PACKAGES=
EXTERNAL_PYTHON_SITE_PACKAGES=
PARAVIEW_VERSION=6.0.1
FITS_PREVIEW_FACTOR=1
FITS_VOLUME_PREVIEW_AUTO_ENABLE=true
FITS_VOLUME_PREVIEW_SIZE_THRESHOLD_MB=256
FITS_VOLUME_PREVIEW_MAX_VOXELS=2097152
FITS_VOLUME_PREVIEW_MAX_MB=128
